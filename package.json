{
  "name": "yuelicopilot",
  "private": false,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "install:executor-deps": "npm install --prefix server",
    "migrate:session-messages": "node scripts/migrate_session_messages.mjs",
    "sign-skillpkg": "node scripts/sign-skillpkg.mjs",
    "pack-skillpkg": "node scripts/sign-skillpkg.mjs",
    "start": "node packages/runtime-core/bin/yueli-up.mjs",
    "start:desktop": "YUELI_DEPLOY_PROFILE=desktop node packages/runtime-core/bin/yueli-up.mjs",
    "build:desktop": "tsc && vite build --mode desktop",
    "gateway:serve": "node packages/gateway/bin/serve.mjs",
    "electron:prepare": "node scripts/prepare-electron-staging.mjs",
    "electron:dev": "npm run build:desktop && npm install --prefix apps/desktop && npm run dev --prefix apps/desktop",
    "electron:pack": "npm run electron:prepare && npm install --prefix apps/desktop && npm run pack --prefix apps/desktop",
    "electron:dist": "npm run electron:prepare && npm install --prefix apps/desktop && npm run dist --prefix apps/desktop",
    "electron:dist:unsigned": "npm run electron:prepare && npm install --prefix apps/desktop && CSC_IDENTITY_AUTO_DISCOVERY=false npm run dist --prefix apps/desktop",
    "notarize:app": "bash apps/desktop/scripts/notarize-app.sh",
    "icons:desktop": "bash apps/desktop/scripts/generate-icons.sh",
    "release:mac": "bash scripts/release-build.sh",
    "migrate:desktop-data": "node scripts/migrate-desktop-data.mjs",
    "build:server-static": "VITE_KGM_BASE_URL=/kgm VITE_SKILL_EXECUTOR_URL=/api VITE_DEPLOY_PROFILE=desktop vite build"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "@haxitag/markdown-gfm-normalize": "file:../Yueli-KGM-Computing/packages/markdown-gfm-normalize",
    "@haxitag/yueli-kgm-computing": "0.3.11",
    "@types/mdast": "^4.0.4",
    "@types/node-cron": "^3.0.11",
    "acorn": "^8.16.0",
    "acorn-walk": "^8.3.5",
    "antd": "^5.11.7",
    "axios": "^1.6.2",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dompurify": "^3.4.3",
    "express": "^5.2.1",
    "iconv-lite": "^0.7.2",
    "katex": "^0.16.45",
    "mermaid": "^11.14.0",
    "node-cron": "^4.2.1",
    "pdfjs-dist": "^4.10.38",
    "puppeteer": "^24.42.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.20.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "socket.io-client": "^4.8.3",
    "styled-components": "^6.1.1",
    "typescript": "^5.2.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/expect": "^3.2.4",
    "@vitest/mocker": "^3.2.4",
    "@vitest/pretty-format": "^3.2.4",
    "@vitest/runner": "^3.2.4",
    "@vitest/snapshot": "^3.2.4",
    "@vitest/spy": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vitest/utils": "^3.2.4",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "jsdom": "^28.1.0",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@haxitag/yueli-kgm-computing": {
      "@haxitag/markdown-gfm-normalize": "file:../Yueli-KGM-Computing/packages/markdown-gfm-normalize"
    },
    "fdir": {
      "picomatch": "4.0.4"
    },
    "minimatch": "^9.0.7"
  }
}
