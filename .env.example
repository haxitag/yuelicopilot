# YueliCopilot 端到端系统端口配置

# 前端应用服务端口 (Vite Dev Server)
FRONTEND_PORT=3002

# Skill Executor 代理执行沙箱端口
SKILL_EXECUTOR_PORT=3010
# 生产/非本机访问必须配置 API Token；浏览器侧如需直连，同步设置 VITE_SKILL_EXECUTOR_API_TOKEN
SKILL_EXECUTOR_API_TOKEN=
SKILL_EXECUTOR_JSON_LIMIT=20mb
SKILL_EXECUTOR_FS_ROOT=./server/data/fs-sandbox
SKILL_EXECUTOR_FS_READ_LIMIT_BYTES=1048576
SKILL_EXECUTOR_FS_WRITE_LIMIT_BYTES=1048576
# 详见 docs/沙箱.md（Runner 建立、YUELI_ALLOW_SKILL_RUNTIME、预检与联调验证）

# Yueli-KGM-Computing 模型推理与聚合端口（与 start.sh 默认 3080 一致；勿与旧默认 3000 混淆）
KGM_PORT=3080

# ----- 前端连接配置 (暴露给 Vite 客户端读取) -----
# VITE_KGM_PORT：当 VITE_KGM_BASE_URL 含字面量 ${KGM_PORT} 时，前端占位替换依赖此变量（Vite 不会自动展开 .env 里的嵌套引用）
VITE_KGM_PORT=3080
VITE_FRONTEND_PORT=${FRONTEND_PORT}
VITE_KGM_BASE_URL=http://127.0.0.1:3080
VITE_SKILL_EXECUTOR_URL=http://127.0.0.1:${SKILL_EXECUTOR_PORT}
VITE_SKILL_EXECUTOR_API_TOKEN=${SKILL_EXECUTOR_API_TOKEN}

# Ollama /api/generate 是否带 think=true。未写入 localStorage 且无有效构建变量时默认关闭。
# 需要原生思考链时再改为 true。
VITE_OLLAMA_THINK=false

# 内置云端推理：Yueli AI freemodel（首次启动写入 cloudProviders，见 docs/调用 yueliai-api-freemodel.md）
# VITE_YUELIAI_API_KEY=sk-...

# Jina Reader（r.jina.ai）可选 API Key，提升速率与稳定性；见 docs/实时网络研究技能.md
# JINA_API_KEY=

# PaddleOCR AI Studio（截图/图片 OCR 入库）；见 docs/PaddleOCR截图入库.md
# PADDLE_OCR_TOKEN=
# PADDLE_OCR_MODEL=PaddleOCR-VL-1.5

# PDF 文档库：本地默认 SQLite（server/data/chat_documents.sqlite），向量走 KGM Chroma（见 data/kgm.config.json）
# 仅服务端集中部署时再配置 Postgres；勿用 DATABASE_URL 误触发文档库
# CHAT_DOCUMENTS_DATABASE_URL=postgresql://user:pass@host:5432/yueli
# KGM_SYNC_ON_INGEST=0
PADDLE_OCR_TOKEN=0cf8e5b445ad3fb9cb74ff222d75fe0c0ef5d123