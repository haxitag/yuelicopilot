# 公证凭据：复制为 .notarize.env（已被 .gitignore 排除，勿提交）
# 与 deck 同账号：cp ../deck/apps/desktop/.notarize.env apps/desktop/.notarize.env
# Apple ID（邮箱）
APPLE_ID=
# App 专用密码：https://appleid.apple.com → 登录与安全 → App 专用密码
APPLE_APP_SPECIFIC_PASSWORD=
# Team ID：Apple Developer → Membership
APPLE_TEAM_ID=
# 可选：用 xcrun notarytool store-credentials 写入钥匙串后填 profile 名（优先于上面三项）
# NOTARY_KEYCHAIN_PROFILE=yueli-notarize
# 公证失败时仍继续打包（仅调试，产物未公证）
# SKIP_NOTARIZE_ON_ERROR=true
